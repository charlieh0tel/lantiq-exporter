[Unit]
Description=Lantiq/Falcon GPON ONT Prometheus exporter
Documentation=file:/usr/share/doc/lantiq-exporter/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=lantiq-exporter
Group=lantiq-exporter
EnvironmentFile=/etc/lantiq-exporter/config
ExecStart=/usr/bin/lantiq-exporter $LANTIQ_EXPORTER_ARGS
Restart=on-failure
RestartSec=5

# Hardening: it only needs to read its own state dir and reach the stick via ssh.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
StateDirectory=lantiq-exporter
# ssh key + known_hosts live in the service user's home:
Environment=HOME=/var/lib/lantiq-exporter

[Install]
WantedBy=multi-user.target
