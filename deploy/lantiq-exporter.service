[Unit]
Description=Lantiq/Falcon GPON ONT Prometheus exporter
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Adjust User and WorkingDirectory to wherever you cloned this.
User=ch
WorkingDirectory=/home/ch/src/lantiq-exporter
ExecStart=/usr/bin/python3 /home/ch/src/lantiq-exporter/ont_exporter.py \
  --serve --addr 127.0.0.1 --port 9909 --interval 30
Restart=on-failure
RestartSec=5
# Hardening (the exporter only needs to read its own dir + reach the stick over SSH)
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/tmp
PrivateTmp=true

[Install]
WantedBy=multi-user.target
